
# Recommendation System using Collaborative Filtering

# User ratings for movies
ratings = {
    'User1': {'MovieA': 5, 'MovieB': 4, 'MovieC': 1},
    'User2': {'MovieA': 5, 'MovieB': 4, 'MovieD': 5},
    'User3': {'MovieA': 1, 'MovieC': 5, 'MovieD': 2}
}

print("COLLABORATIVE FILTERING RECOMMENDATION SYSTEM")

# Display ratings
print("\nUser Ratings:")
for user, movies in ratings.items():
    print(user, ":", movies)

# Input user
target = input("\nEnter user name (User1/User2/User3): ")

# Check user
if target not in ratings:
    print("Invalid User")

else:
    target_movies = ratings[target]

    # Find similar user
    best_user = None
    best_score = -1

    for user in ratings:
        if user != target:
            common = set(target_movies) & set(ratings[user])

            if common:
                score = sum(
                    target_movies[m] == ratings[user][m]
                    for m in common
                )

                if score > best_score:
                    best_score = score
                    best_user = user

    # Recommend unrated movies
    print("\nRecommendations for", target, ":")

    if best_user is None:
        print("No recommendations available")

    else:
        recommendations = []

        for movie, rating in ratings[best_user].items():
            if movie not in target_movies and rating >= 4:
                recommendations.append(movie)

        if recommendations:
            for movie in recommendations:
                print(movie)
        else:
            print("No new recommendations available")
