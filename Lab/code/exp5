from collections import deque

# State: (missionaries_left, cannibals_left, boat_position)
# Boat position: 0 = left bank, 1 = right bank

def solve():
    start = (3, 3, 0)
    goal = (0, 0, 1)

    # Possible people in the boat
    moves = [(1, 0), (2, 0), (0, 1),
             (0, 2), (1, 1)]

    # Queue stores states and their paths
    queue = deque([(start, [start])])
    visited = {start}

    while queue:
        state, path = queue.popleft()
        m, c, boat = state

        # Check if everyone crossed the river
        if state == goal:
            return path

        for dm, dc in moves:

            # Calculate the new state
            if boat == 0:
                new_state = (m - dm, c - dc, 1)
            else:
                new_state = (m + dm, c + dc, 0)

            nm, nc, nb = new_state

            # Check whether the numbers are valid
            if nm < 0 or nc < 0 or nm > 3 or nc > 3:
                continue

            # Check missionary safety on both banks
            if (nm > 0 and nc > nm) or \
               (3 - nm > 0 and 3 - nc > 3 - nm):
                continue

            # Add new states that are not visited
            if new_state not in visited:
                visited.add(new_state)
                queue.append((new_state, path + [new_state]))

    return None


# Solve the problem
solution = solve()

# Display the solution
if solution:
    print("Solution:")
    for state in solution:
        print(state)
else:
    print("No solution found")
