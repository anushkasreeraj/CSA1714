from collections import deque

# Function to solve the Water Jug Problem
def water_jug(jug1, jug2, target):

    # Queue stores the current state and the path
    queue = deque([((0, 0), [])])

    # Store already visited states
    visited = set()

    while queue:

        # Get the current state
        (a, b), path = queue.popleft()

        # If this state was already visited, skip it
        if (a, b) in visited:
            continue

        visited.add((a, b))

        # If target amount is reached
        if a == target or b == target:
            return path + [(a, b)]

        # All possible operations
        states = [
            ((jug1, b), "Fill Jug 1"),
            ((a, jug2), "Fill Jug 2"),
            ((0, b), "Empty Jug 1"),
            ((a, 0), "Empty Jug 2"),

            # Pour Jug 1 into Jug 2
            (
                (a - min(a, jug2 - b),
                 b + min(a, jug2 - b)),
                "Pour Jug 1 into Jug 2"
            ),

            # Pour Jug 2 into Jug 1
            (
                (a + min(b, jug1 - a),
                 b - min(b, jug1 - a)),
                "Pour Jug 2 into Jug 1"
            )
        ]

        # Add new states to the queue
        for state, action in states:
            if state not in visited:
                queue.append((state, path + [(action, state)]))

    return None


# Jug capacities
jug1 = 4
jug2 = 3

# Required amount
target = 2

# Solve the problem
solution = water_jug(jug1, jug2, target)

# Display the solution
print("Solution:")

for step in solution:
    print(step)
