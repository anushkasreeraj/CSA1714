
# BFS implementation using a queue

graph = {
    'A': ['B', 'C'],
    'B': ['D', 'E'],
    'C': ['F'],
    'D': [],
    'E': [],
    'F': []
}

# BFS function
def bfs(start):
    visited = []       # Stores visited nodes
    queue = [start]    # Queue starts with the initial node

    while queue:
        node = queue.pop(0)  # Remove the first node

        if node not in visited:
            print(node, end=" ")
            visited.append(node)

            # Add unvisited neighbours to the queue
            for neighbour in graph[node]:
                if neighbour not in visited:
                    queue.append(neighbour)

# Start BFS from node A
bfs('A')
