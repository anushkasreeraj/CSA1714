from itertools import permutations

# Letters in the puzzle
letters = 'SENDMORY'

# Try assigning different digits to each letter
for digits in permutations(range(10), len(letters)):

    # Create a dictionary for letters and digits
    d = dict(zip(letters, digits))

    # Numbers cannot start with zero
    if d['S'] == 0 or d['M'] == 0:
        continue

    # Form the numbers SEND, MORE and MONEY
    SEND = d['S']*1000 + d['E']*100 + d['N']*10 + d['D']
    MORE = d['M']*1000 + d['O']*100 + d['R']*10 + d['E']
    MONEY = d['M']*10000 + d['O']*1000 + d['N']*100 + d['E']*10 + d['Y']

    # Check whether the equation is correct
    if SEND + MORE == MONEY:
        print("SEND =", SEND)
        print("MORE =", MORE)
        print("MONEY =", MONEY)
        break
