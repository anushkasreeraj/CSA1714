
# A* Search Algorithm

# Input: Graph with distances between nodes
graph = {
    'A': {'B': 1, 'C': 3},
    'B': {'D': 3, 'E': 1},
    'C': {'F': 5},
    'D': {'G': 2},
    'E': {'G': 3},
    'F': {'G': 2},
    'G': {}
}

# Heuristic values to goal G
h = {
    'A': 6,
    'B': 5,
    'C': 5,
    'D': 2,
    'E': 3,
    'F': 2,
    'G': 0
}

# Display the inputs
print("Graph:")
for node in graph:
    print(node, ":", graph[node])

print("\nHeuristic Values:", h)
print("Start Node: A")
print("Goal Node: G")


# A* function
def astar(start, goal):
    open_list = [start]
    cost = {start: 0}
    parent = {}

    while open_list:
        # Select node with lowest f(n) = g(n) + h(n)
        current = min(open_list,
                      key=lambda n: cost[n] + h[n])

        # Check if goal is reached
        if current == goal:
            path = []
            while current in parent:
                path.append(current)
                current = parent[current]
            path.append(start)
            path.reverse()
            return path, cost[goal]

        open_list.remove(current)

        # Check neighbouring nodes
        for neighbour, distance in graph[current].items():
            new_cost = cost[current] + distance

            if neighbour not in cost or new_cost < cost[neighbour]:
                cost[neighbour] = new_cost
                parent[neighbour] = current

                if neighbour not in open_list:
                    open_list.append(neighbour)

    return None, float('inf')


# Run A* Search
path, total_cost = astar('A', 'G')

# Display the output
print("\nShortest Path:", " -> ".join(path))
print("Total Cost:", total_cost)
