# AO* function
def ao_star(node):
    if not graph[node]:
        return heuristic[node]

    best_cost = float('inf')
    best_path = None

    for option in graph[node]:
        cost = 0

        for child, edge_cost in option:
            cost += edge_cost + ao_star(child)

        if cost < best_cost:
            best_cost = cost
            best_path = option

    heuristic[node] = best_cost
    solution[node] = best_path

    return best_cost


# Display solution path
def display_path(node):
    print(node, end=" ")

    if node in solution:
        for child, cost in solution[node]:
            display_path(child)


